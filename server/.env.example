PORT=5000
# Prefer standard mongodb:// host list if mongodb+srv fails with queryTxt ETIMEOUT (DNS TXT blocked).
MONGO_URI=mongodb://localhost:27017/devlens-ai

# Required for signing JWTs (use a long random string in production)
JWT_SECRET=

# Frontend origin(s) for CORS + redirects (comma-separated if multiple)
CLIENT_URL=http://localhost:5173

# Set COOKIE_SECURE=true behind HTTPS in production (httpOnly auth cookies)
# COOKIE_SECURE=false

# Set TRUST_PROXY=true when behind nginx / Cloudflare / a load balancer
# TRUST_PROXY=true

# Public API base used in verification email links (defaults to http://localhost:PORT)
API_PUBLIC_URL=http://localhost:5000

# Gmail SMTP for contact form + email verification
EMAIL_USER=
EMAIL_PASS=

# GitHub personal access token (recommended — avoids rate limits on unauthenticated API)
# Create one at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# OpenAI (preferred) — uses gpt-4o-mini only
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini (fallback if OpenAI is missing or fails)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
